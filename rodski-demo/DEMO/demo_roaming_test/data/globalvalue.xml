<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
    <group name="DefaultValue">
    <!-- 自动等待（毫秒）：查找测试对象（type 每个字段 / verify / get 等）最多等 5000ms，元素出现即继续；不设置 = 不自动等待 -->
    <var name="AutoWait" value="5000"/>
        <var name="WaitTime" value="0"/>
    </group>
    <group name="Demo">
        <var name="URL" value="http://127.0.0.1:0/index.html"/>
    </group>
    <group name="Roam">
        <var name="Enabled" value="是"/>
        <var name="MaxVariantsPerCase" value="1"/>
        <var name="MaxDurationSeconds" value="30"/>
        <var name="MinConfidenceToAct" value="0.6"/>
        <var name="MaxTokenBudget" value="20000"/>
        <var name="MaxCostUsd" value="0.5"/>
    </group>
</globalvalue>
