<?xml version="1.0" encoding="UTF-8"?>
<suite>
    <!-- AC-037: 数据驱动场景的驱动动作日志 -->
    <case id="AC-037" batch="AC037_TestData" priority="P1">
        <description>
            测试数据驱动场景中驱动动作级别的日志记录
            验收标准：
            1. 两行数据分别调用不同的业务流程
            2. driver_actions.jsonl 中每个动作记录包含上下文（case/row/data_id/flow）
            3. 可以通过 jq 过滤第1行的所有驱动动作
            4. 可以对比两行的驱动动作差异
        </description>

        <pre_process>
            <test_step action="launch" browser="chromium"/>
            <test_step action="navigate" model="" data="https://example.com/multi-flow"/>
        </pre_process>

        <test_case>
            <scenario id="S001" description="数据驱动 - 驱动动作日志">
                <!-- 这里的 batch 数据会调用不同的业务流程 -->
                <test_step action="business_call" model="multi_flow" data="AC037_TestData"/>
                <test_step action="wait" model="" data="1"/>
                <test_step action="verify" model="FlowResult" data="AC037_TestData_verify"/>
            </scenario>
        </test_case>

        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>
</suite>
