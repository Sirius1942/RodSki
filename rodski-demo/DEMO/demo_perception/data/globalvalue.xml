<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
  <group name="DefaultValue">
    <!-- 自动等待（毫秒）：查找测试对象（type 每个字段 / verify / get 等）最多等 5000ms，元素出现即继续；不设置 = 不自动等待 -->
    <var name="AutoWait" value="5000"/>
  </group>
  <group name="PerceptionConfig">
    <!-- Backend 选择：local（rodski-perception via ollama）-->
    <var name="perception_backend" value="local"/>

    <!-- LocalBackend 配置 -->
    <var name="perception_model" value="qwen3-vl:2b"/>
    <var name="ollama_host" value="http://localhost:11434"/>

    <!-- 评测/调试用：是否保存推理过程的标注图 -->
    <var name="perception_save_annotated" value="false"/>
  </group>

  <group name="TestEnv">
    <var name="test_app_url" value="http://localhost:8000"/>
  </group>
</globalvalue>
