<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
  <group name="DefaultValue">
    <!-- WaitTime 单位毫秒（v11.6.0 起，与 <cases step_wait> 一致）；0 = 不做步后固定等待 -->
    <var name="WaitTime" value="0"/>
    <!-- 自动等待（v11.7.0）：每次查找测试对象（type 每个字段 / verify / get 等）最多等 5000ms，元素出现即继续 -->
    <var name="AutoWait" value="5000"/>
    <var name="Headless" value="False"/>
  </group>

  <group name="Mobile">
    <var name="Platform" value="android"/>
    <var name="AutomationBackend" value="appium"/>
    <var name="AppiumServer" value="http://127.0.0.1:4723"/>
    <var name="DeviceName" value="AKRSUT1618000209"/>
    <var name="AppPackage" value="com.rodski.demo"/>
    <var name="AppActivity" value=".LoginActivity"/>
    <var name="AppTarget" value="app://android/com.rodski.demo/.LoginActivity"/>
    <var name="NoReset" value="true"/>

    <!-- 设备选择（用例执行层配置，v11.3.0）
         这些变量不属于被测应用，而属于「这次执行用几台什么设备」：
           DeviceCount  期望设备数（默认 1）
           DeviceMix    组合偏好，逗号分隔，可选 real / simulator（顺序即优先级）
           DeviceScope  只在某个类别里挑：all | real | simulator
           DeviceList   显式设备池（UDID 列表），给定时跳过自动发现
         零设备是唯一硬失败；数量/类别不足会降级并打印 [WARN]，不会拒绝执行。
         `rodski run @plan` 检测到本组非默认即自动转 `rodski queue`；
         想强制单设备执行（含显式 UDID 时）加 no-queue 选项。

         Android 侧的 real 指 adb 里 serial 非 `emulator-` 前缀的实体设备，
         simulator 指 AVD（serial 形如 emulator-5554）。 -->
    <var name="DeviceCount" value="2"/>
    <var name="DeviceMix" value="real,simulator"/>
  </group>
</globalvalue>
