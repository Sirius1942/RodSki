<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="订单号" android:textStyle="bold"/>
    <TextView android:id="@+id/orderNo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="客户名" android:textStyle="bold"/>
    <TextView android:id="@+id/customerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="金额" android:textStyle="bold"/>
    <TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="状态" android:textStyle="bold"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
