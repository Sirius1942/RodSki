<?xml version="1.0" encoding="UTF-8"?>
<!-- REQ-015（v11.10.0）：不设置 AutoWait 时默认最多等待 10000ms、每 1000ms 探测一次。
     元素 3s 后出现 → 通过；元素 20s 才出现 → 约 10s 失败（expect_fail），错误信息标明使用默认值与探测次数 -->
<cases tags="v1110,autowait,default">
  <case execute="是" id="TC001" title="默认 AutoWait：3s 后出现的按钮 click 通过" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/late_button.html?d=3000"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="LateButton" data="C001"/>
      <test_step action="verify" model="LateButton" data="V001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC002" title="默认 AutoWait：3s 后出现的输入框输入通过" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/late_input.html?d=3000"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="LateInput" data="I001"/>
      <test_step action="verify" model="LateInput" data="V001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC003" title="默认 AutoWait：UI verify 等待 3s 后出现的文本" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/late_get.html?d=3000"/>
    </pre_process>
    <test_case>
      <test_step action="verify" model="LateGet" data="V001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC004" title="默认 AutoWait：get 读取 3s 后出现的文本" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/late_get.html?d=3000"/>
    </pre_process>
    <test_case>
      <test_step action="get" model="LateGet" data="G001"/>
      <test_step action="verify" model="LateGetRef" data="V001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC005" title="默认 AutoWait：20s 才出现的按钮在约 10s 失败" component_type="界面" priority="P0" expect_fail="是">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/late_button.html?d=20000"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="LateButton" data="C001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC006" title="默认 AutoWait：就绪页面无额外等待" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/ready.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="ReadyForm" data="R001"/>
      <test_step action="verify" model="ReadyForm" data="V001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC007" title="默认 AutoWait：多定位器全不命中，失败耗时约 1 × 10s" component_type="界面" priority="P0" expect_fail="是">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/multi_locator.html?d=2000"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="MultiMiss" data="M001"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
</cases>
