<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
  <group name="DefaultValue">
    <!-- 显式 AutoWait=0：关闭自动等待，每个定位器只尝试一次。
         v11.10.0（REQ-015）起"不设置"不再等于 0，而是默认最多等待 10000ms（见 ../autowait_default） -->
    <var name="AutoWait" value="0"/>
  </group>
  <group name="Site">
    <!-- 与 autowait 共用站点（../autowait/fun/site），由其 run_acceptance.py 启动 -->
    <var name="URL" value="http://127.0.0.1:8767"/>
  </group>
</globalvalue>
