<?xml version="1.0" encoding="UTF-8"?>
<!--
  F068 <elif> 与 if 嵌套（≤2 层）（TEST_CASE_WRITING_GUIDE §3.8；CORE §12.2 多条件分支 / 嵌套 if、§12.6 约束 2~4；
  case.xsd：loop 容器可含 if/elif/else）
  写法约定同 branch_else.xml：不应执行的分支 run fail.py；应执行的分支 mark + 命中计数；末尾 assert_eq 自检。
  F068_01~02 使用 text_contains 条件（可隔离"条件求值"与"分支结构"两类问题）；
  F068_03~07 分别覆盖 loop 内嵌 if、循环变量条件、变量 elif、CORE 原文嵌套示例与 >= / <= 运算符。
-->
<cases step_wait="0" tags="flow,branch">

    <case execute="是" id="F068_01" title="F068 elif 链：命中第二个 elif；全假走 else；if 为真时 elif 不再评估"
          component_type="界面" priority="P1">
        <pre_process>
            <test_step action="navigate" model="" data="GlobalValue.CfPage.READY"/>
            <test_step action="set" model="" data="hits=n"/>
        </pre_process>
        <test_case>
            <if condition="text_contains('NO-1')">
                <test_step action="run" model="" data="fail.py F068_01_a_if"/>
            </if>
            <elif condition="text_contains('NO-2')">
                <test_step action="run" model="" data="fail.py F068_01_a_elif1"/>
            </elif>
            <elif condition="text_contains('PAID')">
                <test_step action="run" model="" data="mark.py F068_01_a_elif2"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
            </elif>
            <else>
                <test_step action="run" model="" data="fail.py F068_01_a_else"/>
            </else>

            <if condition="text_contains('NO-3')">
                <test_step action="run" model="" data="fail.py F068_01_b_if"/>
            </if>
            <elif condition="text_contains('NO-4')">
                <test_step action="run" model="" data="fail.py F068_01_b_elif"/>
            </elif>
            <else>
                <test_step action="run" model="" data="mark.py F068_01_b_else"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
            </else>

            <if condition="text_contains('CF-PAGE-READY')">
                <test_step action="run" model="" data="mark.py F068_01_c_if"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
            </if>
            <elif condition="text_contains('PAID')">
                <test_step action="run" model="" data="fail.py F068_01_c_elif_should_not_run"/>
            </elif>
            <else>
                <test_step action="run" model="" data="fail.py F068_01_c_else"/>
            </else>
            <test_step action="run" model="" data="assert_eq.py ${hits} nxxx F068_01命中次数"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>

    <case execute="是" id="F068_02" title="F068 if 嵌套 2 层（内层 if/else）；外层为假时内层不评估"
          component_type="界面" priority="P1">
        <pre_process>
            <test_step action="navigate" model="" data="GlobalValue.CfPage.READY"/>
            <test_step action="set" model="" data="hits=n"/>
        </pre_process>
        <test_case>
            <if condition="text_contains('CF-PAGE-READY')">
                <test_step action="run" model="" data="mark.py F068_02_outer_then"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
                <if condition="text_contains('NO-SUCH-TEXT')">
                    <test_step action="run" model="" data="fail.py F068_02_inner1_then"/>
                    <else>
                        <test_step action="run" model="" data="mark.py F068_02_inner1_else"/>
                        <test_step action="set" model="" data="hits=${hits}x"/>
                    </else>
                </if>
                <if condition="text_contains('PAID')">
                    <test_step action="run" model="" data="mark.py F068_02_inner2_then"/>
                    <test_step action="set" model="" data="hits=${hits}x"/>
                </if>
                <else>
                    <test_step action="run" model="" data="fail.py F068_02_outer_else"/>
                </else>
            </if>
            <if condition="text_contains('NO-SUCH-TEXT')">
                <if condition="text_contains('PAID')">
                    <test_step action="run" model="" data="fail.py F068_02_inner_of_false_outer"/>
                </if>
                <else>
                    <test_step action="run" model="" data="mark.py F068_02_false_outer_else"/>
                    <test_step action="set" model="" data="hits=${hits}x"/>
                </else>
            </if>
            <test_step action="run" model="" data="assert_eq.py ${hits} nxxxx F068_02命中次数"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>

    <case execute="是" id="F068_03" title="F068 loop 内嵌 if/else（文本条件，每轮都应命中 then）"
          component_type="界面" priority="P1">
        <pre_process>
            <test_step action="navigate" model="" data="GlobalValue.CfPage.READY"/>
            <test_step action="set" model="" data="hits=n"/>
        </pre_process>
        <test_case>
            <loop range="1-2" var="i">
                <test_step action="run" model="" data="mark.py F068_03_iter_${i}"/>
                <if condition="text_contains('CF-PAGE-READY')">
                    <test_step action="run" model="" data="mark.py F068_03_loopif_${i}"/>
                    <test_step action="set" model="" data="hits=${hits}x"/>
                    <else>
                        <test_step action="run" model="" data="fail.py F068_03_loopelse_${i}"/>
                    </else>
                </if>
            </loop>
            <test_step action="run" model="" data="assert_eq.py ${hits} nxx F068_03命中次数"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>

    <case execute="是" id="F068_04" title="F068 loop 内 if/elif/else 按循环变量 ${i} 分流"
          component_type="接口" priority="P1">
        <pre_process>
            <test_step action="set" model="" data="seq=n"/>
        </pre_process>
        <test_case>
            <loop range="1-3" var="i">
                <if condition="${i} == 2">
                    <test_step action="run" model="" data="mark.py F068_04_if_${i}"/>
                    <test_step action="set" model="" data="seq=${seq}T"/>
                </if>
                <elif condition="${i} == 3">
                    <test_step action="run" model="" data="mark.py F068_04_elif_${i}"/>
                    <test_step action="set" model="" data="seq=${seq}E"/>
                </elif>
                <else>
                    <test_step action="run" model="" data="mark.py F068_04_else_${i}"/>
                    <test_step action="set" model="" data="seq=${seq}L"/>
                </else>
            </loop>
            <test_step action="run" model="" data="assert_eq.py ${seq} nLTE F068_04分流序列"/>
        </test_case>
    </case>

    <case execute="是" id="F068_05" title="F068 变量 elif（GUIDE §3.8 变量引用 + CORE §12.2 elif 结构：401 命中 elif）"
          component_type="接口" priority="P1">
        <pre_process>
            <test_step action="set" model="" data="hits=n"/>
            <test_step action="set" model="" data="login_status=401"/>
        </pre_process>
        <test_case>
            <if condition="${login_status} == 200">
                <test_step action="run" model="" data="fail.py F068_05_if"/>
            </if>
            <elif condition="${login_status} == 401">
                <test_step action="run" model="" data="mark.py F068_05_elif"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
            </elif>
            <else>
                <test_step action="run" model="" data="fail.py F068_05_else"/>
            </else>
            <test_step action="run" model="" data="assert_eq.py ${hits} nx F068_05命中次数"/>
        </test_case>
    </case>

    <case execute="是" id="F068_06" title="F068 嵌套 if（CORE §12.2 原文：${total} &gt; 0 内嵌 ${total} &gt;= 3）"
          component_type="接口" priority="P1">
        <pre_process>
            <test_step action="set" model="" data="hits=n"/>
            <test_step action="set" model="" data="total=5"/>
        </pre_process>
        <test_case>
            <if condition="${total} &gt; 0">
                <test_step action="run" model="" data="mark.py F068_06_outer"/>
                <test_step action="set" model="" data="hits=${hits}x"/>
                <if condition="${total} &gt;= 3">
                    <test_step action="run" model="" data="mark.py F068_06_inner"/>
                    <test_step action="set" model="" data="hits=${hits}x"/>
                    <else>
                        <test_step action="run" model="" data="fail.py F068_06_inner_else"/>
                    </else>
                </if>
                <else>
                    <test_step action="run" model="" data="fail.py F068_06_outer_else"/>
                </else>
            </if>
            <test_step action="run" model="" data="assert_eq.py ${hits} nxx F068_06命中次数"/>
        </test_case>
    </case>

    <case execute="是" id="F068_07" title="F068 比较运算符 &gt; &lt; &gt;= &lt;=（字面量，隔离变量解析问题）"
          component_type="接口" priority="P2">
        <pre_process>
            <test_step action="set" model="" data="hits=n"/>
        </pre_process>
        <test_case>
            <if condition="5 &gt; 3">
                <test_step action="set" model="" data="hits=${hits}g"/>
                <else><test_step action="run" model="" data="fail.py F068_07_gt"/></else>
            </if>
            <if condition="2 &lt; 3">
                <test_step action="set" model="" data="hits=${hits}l"/>
                <else><test_step action="run" model="" data="fail.py F068_07_lt"/></else>
            </if>
            <if condition="5 &gt;= 3">
                <test_step action="set" model="" data="hits=${hits}G"/>
                <else><test_step action="run" model="" data="fail.py F068_07_ge"/></else>
            </if>
            <if condition="2 &lt;= 3">
                <test_step action="set" model="" data="hits=${hits}L"/>
                <else><test_step action="run" model="" data="fail.py F068_07_le"/></else>
            </if>
            <test_step action="run" model="" data="assert_eq.py ${hits} nglGL F068_07运算符命中序列"/>
        </test_case>
    </case>

</cases>
