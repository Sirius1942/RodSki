<?xml version="1.0" encoding="UTF-8"?>
<!-- F073 SessionMode=shared_session（CORE §23.1、GUIDE §6.4.4）：
     「用例间共用同一 context 和页面（等价于以往不写 close）」—— TC001 写入 localStorage + cookie 后执行 close，
     TC002 重新打开页面应仍读到 S1（shared_session 下 close 不关闭会话）。
     run_acceptance.py 还会用 CLI 参数 session-mode=isolated / shared_browser 覆盖 globalvalue，
     此时 TC002 应读不到标记（失败），以证明 CLI 覆盖生效。 -->
<cases tags="f073,session_mode">
  <case execute="是" id="TC001" title="写入 localStorage 与 cookie 标记" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/session.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="SessionPage" data="D_MARK"/>
      <test_step action="verify" model="SessionPage" data="V_MARKED"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>

  <case execute="是" id="TC002" title="下一用例仍能读到上一用例写入的标记" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/session.html"/>
    </pre_process>
    <test_case>
      <test_step action="verify" model="SessionPage" data="V_MARKED"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
</cases>
