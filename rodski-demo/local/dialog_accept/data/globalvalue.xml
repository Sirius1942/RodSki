<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
  <group name="DefaultValue">
    <var name="WaitTime" value="0"/>
    <!-- 自动等待（毫秒）：查找测试对象（type 每个字段 / verify / get 等）最多等 5000ms，元素出现即继续 -->
    <var name="AutoWait" value="5000"/>
    <!-- F072：未注册一次性处理器的原生弹窗一律 accept（TEST_CASE_WRITING_GUIDE §6.4.3） -->
    <var name="DialogPolicy" value="accept"/>
  </group>
  <group name="Site">
    <!-- 由 dialog_accept/run_acceptance.py 以 dialog_accept/fun/site 为根目录启动的本地服务 -->
    <var name="URL" value="http://127.0.0.1:18130"/>
  </group>
</globalvalue>
