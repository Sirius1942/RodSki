    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/async_table_v2.html"/>
    </pre_process>
    <test_case>
      <test_step action="verify" model="AsyncTable" data="V_ROWS"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC002" title="未注册处理器的弹窗在 DialogPolicy=fail 下失败" component_type="界面" priority="P0" expect_fail="是">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/dialog.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="DialogPage" data="D_UNEXPECTED"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
