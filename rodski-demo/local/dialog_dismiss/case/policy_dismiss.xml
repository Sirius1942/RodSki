<?xml version="1.0" encoding="UTF-8"?>
<!-- F072 DialogPolicy=dismiss：未注册一次性处理器的 alert / confirm / prompt 全部自动取消（GUIDE §6.4.3、CORE §7.4）；
     一次性 accept 只生效一次，之后回到全局 dismiss（CORE §2.5.6 第 4 条） -->
<cases tags="f072,dialog_policy,dismiss">
  <case execute="是" id="TC001" title="alert 自动关闭，页面继续执行" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/dialog.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="DialogPolicyPage" data="D_ALERT"/>
      <test_step action="verify" model="DialogPolicyPage" data="V_ALERT"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC002" title="confirm 自动取消返回 false" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/dialog.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="DialogPolicyPage" data="D_CONFIRM"/>
      <test_step action="verify" model="DialogPolicyPage" data="V_CONFIRM_FALSE"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC003" title="prompt 自动取消返回 null" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/dialog.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="DialogPolicyPage" data="D_PROMPT"/>
      <test_step action="verify" model="DialogPolicyPage" data="V_PROMPT_NULL"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
  <case execute="是" id="TC004" title="一次性 accept 覆盖全局 dismiss 且只生效一次" component_type="界面" priority="P0">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Site.URL/dialog.html"/>
    </pre_process>
    <test_case>
      <test_step action="type" model="DialogPolicyPage" data="D_ONCE_ACCEPT_CONFIRM"/>
      <test_step action="type" model="DialogPolicyPage" data="D_CONFIRM"/>
      <test_step action="verify" model="DialogPolicyPage" data="V_LOG_TRUE_FALSE"/>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>
</cases>
