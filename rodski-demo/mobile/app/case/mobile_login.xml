<?xml version="1.0" encoding="UTF-8"?>
<!--
  v7 mobile app demo case.
  默认 execute="否"，因为该 demo 需要本机 Android SDK、Appium 和真机/模拟器环境。
-->
<cases step_wait="500" tags="mobile,android,app,demo">
  <case execute="否"
        id="MOB-APP-001"
        title="[mobile/android] Demo App 登录"
        description="准备性移动端 App 示例；当前不计入验收通过"
        component_type="界面"
        priority="P1">
    <pre_process>
      <test_step action="navigate" model="" data="GlobalValue.Mobile.AppTarget"/>
    </pre_process>
    <test_case>
      <scenario id="S001" title="输入手机号和密码" group="mobile" tag="login,input">
        <test_step action="type" model="LoginScreen" data="L001"/>
      </scenario>
      <scenario id="S002" title="验证登录结果" group="mobile" tag="login,verify" depends="S001">
        <test_step action="verify" model="HomeScreen" data="VH001"/>
      </scenario>
    </test_case>
    <post_process>
      <test_step action="close" model="" data=""/>
    </post_process>
  </case>

  <case execute="否"
        id="MOB-APP-002"
        title="[mobile/android] 返回键扩展示例"
        description="run 关键字调用 fun/mobile 脚本示例；当前不计入验收通过"
        component_type="界面"
        priority="P2">
    <test_case>
      <test_step action="run" model="" data="fun/mobile/android_keycode.py 4"/>
    </test_case>
  </case>
</cases>
