            <type>input</type>
            <location type="id">kpInput</location>
            <desc>key_press【Enter】</desc>
        </element>
        <element name="kpSelAll" type="web">
            <type>input</type>
            <location type="id">kpInput</location>
            <desc>key_press【Control+A】</desc>
        </element>
        <element name="kpDel" type="web">
            <type>input</type>
            <location type="id">kpInput</location>
            <desc>key_press【Backspace】</desc>
        </element>
        <element name="kpTab" type="web">
            <type>input</type>
            <location type="id">kpInput</location>
            <desc>key_press【Tab】</desc>
