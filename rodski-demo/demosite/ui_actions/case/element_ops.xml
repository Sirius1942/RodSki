<?xml version="1.0" encoding="UTF-8"?>
<!--
  F040 UI 元素级操作符 $count / $count_gte / $count_lte / $exists / $visible
  （TEST_CASE_WRITING_GUIDE §5.7.1；CORE §4.6.1 元素级原生断言）
  页面 #list 有 5 个 li.item（其中 1 个 display:none）；#absent 不存在；#hiddenEl display:none。
  负向用例 expect_fail="是"：verify 必须真的失败（0 匹配不得被跳过，CORE §4.6.1 防静默通过）。
-->
<cases tags="ui_actions,F040">
    <case execute="是" id="OPS_ELEM_OK" title="$count=5 / $count_gte=3 / $exists true,false / $visible true,false" component_type="界面" priority="P1">
        <pre_process>
            <test_step action="navigate" model="" data="GlobalValue.Site.URL/ops.html"/>
        </pre_process>
        <test_case>
            <test_step action="verify" model="ElemOps" data="V_OK"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>

