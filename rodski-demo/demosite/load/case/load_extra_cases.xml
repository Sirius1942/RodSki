<?xml version="1.0" encoding="UTF-8"?>
<cases>
    <!-- F118/F119 压测补充用例（run_acceptance_extra.py 使用）。只复用本模块已有模型与数据行，不改 data.sqlite。 -->

    <!-- 只发请求不 verify：功能执行可通过，压测时只统计 HTTP 结果 -->
    <case execute="是" id="TC-LOAD-X01" title="压测补充-登录接口" component_type="接口">
        <test_case>
            <test_step action="send" model="LoginAPI" data="D001"/>
        </test_case>
    </case>

    <case execute="是" id="TC-LOAD-X02" title="压测补充-订单查询接口" component_type="接口">
        <test_case>
            <test_step action="send" model="OrderAPI" data="D001"/>
        </test_case>
    </case>

    <!-- 界面用例：mode=api 计划引用时必须报 SKI602（LOAD_TESTING_GUIDE §5.1） -->
    <case execute="是" id="TC-LOAD-XUI" title="压测补充-界面用例(负向引用)" component_type="界面">
        <test_case>
            <test_step action="navigate" model="" data="GlobalValue.DefaultValue.URL"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>
</cases>
