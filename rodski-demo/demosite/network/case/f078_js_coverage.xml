<?xml version="1.0" encoding="UTF-8"?>
<cases>
    <!-- F078：start_js_coverage / stop_js_coverage 产物生成与内容
         依据：TEST_CASE_WRITING_GUIDE.md §8.6；CORE_DESIGN_CONSTRAINTS.md §1.4（stop_js_coverage(output) 保存到文件）
         output 为相对路径：按执行时工作目录解析（编排脚本在仓库根目录执行），产物内容由 run_acceptance.py 二次断言 -->

    <case execute="是" id="TC-NET-078-01" title="JS覆盖率采集并写出产物" component_type="界面">
        <pre_process>
            <test_step action="navigate" model="" data="GlobalValue.DefaultValue.URL"/>
            <test_step action="run" model="" data="start_js_coverage()"/>
        </pre_process>
        <test_case>
            <test_step action="type" model="LoginForm" data="L001"/>
            <test_step action="verify" model="Dashboard" data="V_REAL"/>
            <test_step action="run" model="" data="stop_js_coverage(output='rodski-demo/demosite/network/result/net_js_coverage.json')"/>
            <test_step action="verify" model="CoverageResult" data="V001"/>
        </test_case>
        <post_process>
            <test_step action="close" model="" data=""/>
        </post_process>
    </case>
</cases>
