<?xml version="1.0" encoding="UTF-8"?>
<!-- 计划级数据驱动（CORE §7.8）接口 + DB 用例，以及实例间状态隔离用例。 -->
<cases tags="data-driven">
    <case execute="是" id="DD_API" title="登录接口 + 订单查询按驱动表替换" priority="P0">
        <test_case>
            <test_step action="send" model="LoginAPI" data="D001"/>
            <test_step action="verify" model="LoginResp" data="R001"/>
            <test_step action="DB" model="QueryOrder" data="Q001"/>
            <test_step action="verify" model="QueryOrder" data="C001"/>
        </test_case>
    </case>

    <!--
      实例隔离：第 1 个实例结束时 Return[-1] 是登录响应（status=200）、变量 leak_marker=set。
      若第 2 个实例开始时这些状态没有被清理，两个 if 都会命中并执行必然失败的 verify R_LEAK。
      隔离正确时两个条件都引用了不存在的值，按"条件无法评估"跳过分支。
    -->
    <case execute="是" id="DD_STATE" title="实例之间 Return 历史与 set 变量隔离" priority="P1">
        <pre_process>
            <if condition="${Return[-1].status} == 200">
                <test_step action="verify" model="LoginResp" data="R_LEAK"/>
            </if>
            <if condition="${leak_marker} == set">
                <test_step action="verify" model="LoginResp" data="R_LEAK"/>
            </if>
        </pre_process>
        <test_case>
            <test_step action="send" model="LoginAPI" data="D001"/>
            <test_step action="verify" model="LoginResp" data="R001"/>
            <test_step action="set" model="" data="leak_marker=set"/>
            <test_step action="send" model="LoginAPI" data="D001"/>
        </test_case>
    </case>
</cases>
