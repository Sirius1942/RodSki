<?xml version="1.0" encoding="UTF-8"?>
<globalvalue>
    <group name="DefaultValue">
    <!-- 自动等待（毫秒）：查找测试对象（type 每个字段 / verify / get 等）最多等 5000ms，元素出现即继续；不设置 = 不自动等待 -->
    <var name="AutoWait" value="5000"/>
        <var name="URL" value="http://localhost:8000"/>
        <var name="BrowserType" value="chromium"/>
        <!-- WaitTime 单位毫秒（v11.6.0 起，与 <cases step_wait> 一致） -->
        <var name="WaitTime" value="500"/>
        <var name="Headless" value="True"/>
    </group>
    <group name="env">
        <var name="base_url" value="http://localhost:8000"/>
        <var name="api_base" value="http://localhost:8000/api"/>
    </group>
    <group name="sqlite_db">
        <var name="type" value="sqlite"/>
        <var name="database" value="demo.db"/>
    </group>
    <group name="mysql_db">
        <var name="type" value="mysql"/>
        <var name="host" value="localhost"/>
        <var name="port" value="3306"/>
        <var name="user" value="rodski"/>
        <var name="password" value="rodski123"/>
        <var name="database" value="rodski_demo"/>
    </group>
</globalvalue>
