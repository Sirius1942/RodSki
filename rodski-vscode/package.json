{
  "name": "rodski-vscode",
  "displayName": "RodSki Data Editor",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:rodskiTables",
    "workspaceContains:**/data.sqlite"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "rodskiTables",
          "name": "RodSki Tables"
        }
      ]
    },
    "commands": [
      {
        "command": "rodski.openTable",
        "title": "Open Table"
      },
      {
        "command": "rodski.openDb",
        "title": "Open with RodSki Tables"
      },
      {
        "command": "rodski.addTable",
        "title": "RodSki: Add Table"
      },
      {
        "command": "rodski.deleteTable",
        "title": "RodSki: Delete Table"
      },
      {
        "command": "rodski.refresh",
        "title": "RodSki: Refresh"
      },
      {
        "command": "rodski.openCase",
        "title": "Open with RodSki"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rodski.openDb",
          "when": "resourceFilename == data.sqlite",
          "group": "navigation"
        },
        {
          "command": "rodski.openCase",
          "when": "resourceExtname == .xml && resourcePath =~ /\\/case\\//",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rodski.deleteTable",
          "when": "viewItem == rodskiTable",
          "group": "inline"
        }
      ]
    }
  },
  "dependencies": {
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/local/rodski-vscode"
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --minify",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext .ts",
    "test:unit": "node --test test/unit/*.test.js",
    "test:webview": "node --test test/webview/*.test.js",
    "test": "npm run test:unit && npm run test:webview",
    "typecheck": "tsc --noEmit"
  }
}
