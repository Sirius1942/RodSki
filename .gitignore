# RodSki demo 运行产物（不纳入版本控制）
rodski-demo/**/result/
rodski-demo/**/result/**
rodski-demo/**/narrative/
# perf/ 中的编译产物由 LoadCompiler 运行时自动生成，不纳入版本控制
# 目录本身由 .gitkeep 保持存在
rodski-demo/**/perf/*.py
rodski-demo/**/perf/*.py.meta

# 独立子项目 — 各自拥有独立 git 仓库，不由父仓库跟踪
# rodski-web:   官方网站（Next.js），独立发布（见 rodski-web/package.json）
# rodski-agent: AI Agent 层，独立发布（见 rodski-agent/pyproject.toml）
rodski-web/
rodski-agent/

# 发布包目录（仅推送到 GitLab，不推送到 GitHub）
# 通过 scripts/git_push.sh 自动处理双 remote 推送策略
releases/
