/.schema rs_field
/result/
/test_explore_*.py
/test_summary.txt

# Xcode 构建产物（真机/模拟器 demo，体积大且可重建）
rodski-demo/DEMO/mobile_app/demo_ios_app/build_device/

# clawhub 安装遗留的自引用符号链接（`X/X -> X`，会让 zip -r 无限递归撑大发行包）
# 打包脚本已排除它们，这里再从版本控制里挡一道
rodski-skills/rodski-skill--diagnose/rodski-skill--diagnose
rodski-skills/rodski-skill--explore/rodski-skill--explore
rodski-skills/rodski-skill--rodski/rodski-skill--rodski
rodski-skills/rodski-skill--rodski-case-writer/rodski-skill--rodski-case-writer
rodski-skills/rodski-test-guide/rodski-test-guide

# RodSki demo 运行产物（不纳入版本控制）
rodski-demo/**/result/
rodski-demo/**/result/**
rodski-demo/**/narrative/
# perf/ 中的编译产物由 LoadCompiler 运行时自动生成，不纳入版本控制
# 目录本身由 .gitkeep 保持存在
rodski-demo/**/perf/*.py
rodski-demo/**/perf/*.py.meta

# 独立子项目 — 各自拥有独立 git 仓库，不由父仓库跟踪
# rodski-website: 官方网站（Next.js），独立发布（见 rodski-website/package.json）
# rodski-agent:   AI Agent 层，独立发布（见 rodski-agent/pyproject.toml）
rodski-website/
rodski-agent/

# 发布包目录（仅推送到 GitLab，不推送到 GitHub）
# 通过 scripts/git_push.sh 自动处理双 remote 推送策略
releases/
