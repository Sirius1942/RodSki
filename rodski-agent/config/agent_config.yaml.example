# rodski 路径配置
rodski:
  cli_path: "python rodski/ski_run.py"
  validate_cmd: "rodski validate"
  default_browser: "chromium"
  headless: true

# LLM 配置 — 按 Agent 类型分别配置
# 复制此文件为 agent_config.yaml 并填入实际值
llm:
  design:
    provider: claude          # claude | openai
    model: claude-sonnet-4-6
    base_url: ""              # 留空使用官方 API；填入代理地址如 http://your-proxy.example.com
    api_key_env: ANTHROPIC_API_KEY  # 存放 API Key 的环境变量名
    temperature: 0.7
    max_tokens: 4096
  execution:
    provider: claude
    model: claude-sonnet-4-6
    base_url: ""
    api_key_env: ANTHROPIC_API_KEY
    temperature: 0.1
    max_tokens: 2048

# OmniParser 配置（design 命令的视觉元素识别，可选）
omniparser:
  url: "http://localhost:7862"
  timeout: 30

# Agent 行为配置
design:
  max_scenarios: 10
  max_fix_attempts: 3

execution:
  max_retry: 3
  screenshot_on_fail: true
  diagnosis_enabled: true

# 输出配置
output:
  format: "human"
  verbose: false
