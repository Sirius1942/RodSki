<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>
      RodSki Case XML Schema - 测试用例定义规范

      每个 case 下分三阶段（均为容器，内层为多个 test_step）：
      1. pre_process  预处理（可选，0 个或多个 test_step）
      2. test_case    用例阶段（必选，且每个 case 内恰好 1 个；内至少 1 个 test_step）
      3. post_process 后处理（可选，0 个或多个 test_step）

      执行语义：用例阶段若抛出异常，后处理阶段仍会执行（用于清理/关闭等）。
    </xs:documentation>
  </xs:annotation>

  <xs:element name="cases">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="case" type="CaseType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="step_wait" type="xs:string" use="optional"/>
      <xs:attribute name="tags" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- if 容器：条件 + then 分支（支持嵌套 if，最多 2 层） -->
  <xs:complexType name="IfContainerType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="test_step" type="StepType"/>
        <xs:element name="if" type="NestedIfType"/>
      </xs:choice>
      <xs:element name="else" type="ElseType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="condition" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 嵌套 if 容器（第 2 层，不可再嵌套） -->
  <xs:complexType name="NestedIfType">
    <xs:sequence>
      <xs:element name="test_step" type="StepType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="else" type="ElseType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="condition" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- elif 容器：条件 + 步骤（跟在 if 或 elif 后面） -->
  <xs:complexType name="ElifType">
    <xs:sequence>
      <xs:element name="test_step" type="StepType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="condition" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- else 容器 -->
  <xs:complexType name="ElseType">
    <xs:sequence>
      <xs:element name="test_step" type="StepType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- loop 容器：循环执行一组步骤 -->
  <xs:complexType name="LoopContainerType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="test_step" type="StepType"/>
      <xs:element name="if" type="IfContainerType"/>
      <xs:element name="elif" type="ElifType"/>
      <xs:element name="else" type="ElseType"/>
    </xs:choice>
    <xs:attribute name="range" type="xs:string" use="required"/>
    <xs:attribute name="var" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- scenario 容器：场景分组，用于组织 test_case 内的步骤 -->
  <xs:complexType name="ScenarioType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="test_step" type="StepType"/>
      <xs:element name="if" type="IfContainerType"/>
      <xs:element name="elif" type="ElifType"/>
      <xs:element name="else" type="ElseType"/>
      <xs:element name="loop" type="LoopContainerType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="group" type="xs:string" use="optional"/>
    <xs:attribute name="tag" type="xs:string" use="optional"/>
    <xs:attribute name="depends" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- 预处理 / 后处理：0..n 个步骤（支持 if/elif/else/loop 容器） -->
  <xs:complexType name="PhaseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="test_step" type="StepType"/>
      <xs:element name="if" type="IfContainerType"/>
      <xs:element name="elif" type="ElifType"/>
      <xs:element name="else" type="ElseType"/>
      <xs:element name="loop" type="LoopContainerType"/>
    </xs:choice>
  </xs:complexType>

  <!-- 用例阶段：至少 1 个步骤（支持 if/elif/else/loop/scenario 容器） -->
  <xs:complexType name="TestCasePhaseType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="test_step" type="StepType"/>
      <xs:element name="if" type="IfContainerType"/>
      <xs:element name="elif" type="ElifType"/>
      <xs:element name="else" type="ElseType"/>
      <xs:element name="loop" type="LoopContainerType"/>
      <xs:element name="scenario" type="ScenarioType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="CaseType">
    <xs:sequence>
      <xs:element name="metadata" type="MetadataType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="pre_process" type="PhaseType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="test_case" type="TestCasePhaseType" minOccurs="1" maxOccurs="1"/>
      <xs:element name="post_process" type="PhaseType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="execute" type="ExecuteType" use="required"/>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="title" type="xs:string" use="required"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="component_type" type="ComponentType" use="optional"/>
    <xs:attribute name="roam" type="ExecuteType" use="optional" default="否"/>
    <xs:attribute name="expect_fail" type="ExecuteType" use="optional" default="否"/>
    <xs:attribute name="priority" type="PriorityType" use="optional"/>
    <xs:attribute name="tags" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- 元数据类型 -->
  <xs:complexType name="MetadataType">
    <xs:attribute name="created_by" type="xs:string" use="optional"/>
    <xs:attribute name="created_at" type="xs:string" use="optional"/>
    <xs:attribute name="updated_by" type="xs:string" use="optional"/>
    <xs:attribute name="updated_at" type="xs:string" use="optional"/>
    <xs:attribute name="success_rate" type="xs:string" use="optional"/>
    <xs:attribute name="last_run" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- v11.0.0: match_mode 枚举类型 -->
  <xs:simpleType name="MatchModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="strict"/>
      <xs:enumeration value="subset"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="StepType">
    <xs:attribute name="action" type="ActionType" use="required"/>
    <xs:attribute name="model" type="xs:string" use="optional" default=""/>
    <xs:attribute name="data" type="xs:string" use="optional" default=""/>
    <xs:attribute name="match_mode" type="MatchModeType" use="optional" default="strict"/>
  </xs:complexType>

  <xs:simpleType name="ExecuteType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="是"/>
      <xs:enumeration value="否"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ComponentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="界面"/>
      <xs:enumeration value="接口"/>
      <xs:enumeration value="数据库"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PriorityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="P0"/>
      <xs:enumeration value="P1"/>
      <xs:enumeration value="P2"/>
      <xs:enumeration value="P3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ActionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="close"/>
      <xs:enumeration value="type"/>
      <xs:enumeration value="verify"/>
      <xs:enumeration value="wait"/>
      <xs:enumeration value="navigate"/>
      <xs:enumeration value="assert"/>
      <xs:enumeration value="upload_file"/>
      <xs:enumeration value="clear"/>
      <xs:enumeration value="get_text"/>
      <xs:enumeration value="get"/>
      <xs:enumeration value="send"/>
      <xs:enumeration value="set"/>
      <xs:enumeration value="DB"/>
      <xs:enumeration value="run"/>
      <xs:enumeration value="launch"/>
      <xs:enumeration value="check"/>
      <xs:enumeration value="screenshot"/>
      <xs:enumeration value="evaluate"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 漫游测试会话摘要（v8.4.0，用于结果 XML 中的 roam_summary 节点） -->
  <xs:complexType name="RoamSummaryType">
    <xs:sequence>
      <xs:element name="finding" type="RoamFindingType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="stopped_reason" type="xs:string" use="required"/>
    <xs:attribute name="total_variants" type="xs:nonNegativeInteger" use="optional" default="0"/>
    <xs:attribute name="duration" type="xs:decimal" use="optional"/>
    <xs:attribute name="start_screenshot" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="RoamFindingType">
    <xs:attribute name="finding_id" type="xs:string" use="optional"/>
    <xs:attribute name="severity" type="RoamSeverityType" use="optional" default="info"/>
    <xs:attribute name="category" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="screenshot_path" type="xs:string" use="optional"/>
    <xs:attribute name="step_index" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="url" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:simpleType name="RoamSeverityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
