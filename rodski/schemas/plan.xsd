<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="test_plan">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="debug" type="DebugType" minOccurs="0" maxOccurs="1"/>
        <xs:element name="load_profile" type="LoadProfileType" minOccurs="0" maxOccurs="1"/>
        <!-- v11.11.0 测试套（CORE §7.9）：顶层要么全部是 <suite>，要么全部是 <case>/<case_dir>（旧写法 = 隐式套 default），不得混用 -->
        <xs:choice minOccurs="0">
          <xs:element name="suite" type="PlanSuiteType" maxOccurs="unbounded"/>
          <xs:choice maxOccurs="unbounded">
            <xs:element name="case" type="PlanCaseType"/>
            <xs:element name="case_dir" type="PlanCaseDirType"/>
          </xs:choice>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="title" type="xs:string" use="optional"/>
      <xs:attribute name="kind" type="PlanKindType" use="required"/>
      <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
      <xs:attribute name="default_execute" type="ExecuteType" use="optional" default="否"/>
      <!-- v11.11.0：同时执行的测试套数量上限；不写 = 不限（由执行方容量决定）；只用于 kind="suite" -->
      <xs:attribute name="max_parallel" type="xs:positiveInteger" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- v11.11.0 测试套：套内用例顺序执行，套与套之间可以并发分配；子元素语义与计划顶层相同（CORE §7.7） -->
  <xs:complexType name="PlanSuiteType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="case" type="PlanCaseType"/>
      <xs:element name="case_dir" type="PlanCaseDirType"/>
    </xs:choice>
    <xs:attribute name="id" type="SuiteIdType" use="required"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
    <!-- 对执行环境的附加要求（逗号分隔），透传给执行方匹配，rodski 不解释 -->
    <xs:attribute name="tags" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:simpleType name="SuiteIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9_\-]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="DebugType">
    <xs:attribute name="prepare" type="DebugPrepareType" use="optional" default="auto"/>
    <xs:attribute name="step_mode" type="DebugStepModeType" use="optional" default="all"/>
    <xs:attribute name="cleanup" type="ExecuteType" use="optional" default="否"/>
  </xs:complexType>

  <xs:complexType name="PlanCaseType">
    <xs:sequence>
      <xs:element name="scenario" type="PlanScenarioType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="file" type="xs:string" use="optional"/>
    <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
    <xs:attribute name="weight" type="xs:positiveInteger" use="optional" default="1"/>
    <!-- v11.9.0 计划级数据驱动（CORE §7.8）：数据驱动表名（data.sqlite，table_kind=driver），只用于 kind="suite" -->
    <xs:attribute name="data_driven" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PlanCaseDirType">
    <xs:attribute name="path" type="xs:string" use="required"/>
    <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
  </xs:complexType>

  <xs:complexType name="PlanScenarioType">
    <xs:sequence>
      <xs:element name="step" type="PlanStepType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
  </xs:complexType>

  <xs:complexType name="PlanStepType">
    <xs:attribute name="no" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="execute" type="ExecuteType" use="optional" default="是"/>
  </xs:complexType>

  <xs:simpleType name="ExecuteType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="是"/>
      <xs:enumeration value="否"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="LoadProfileType">
    <xs:sequence>
      <xs:element name="concurrency"      type="xs:positiveInteger"/>
      <xs:element name="duration_seconds" type="xs:positiveInteger"/>
      <xs:element name="ramp_up_seconds"  type="xs:nonNegativeInteger" minOccurs="0" default="0"/>
      <xs:element name="think_time_ms"    minOccurs="0">
        <xs:complexType>
          <xs:attribute name="min" type="xs:nonNegativeInteger" default="0"/>
          <xs:attribute name="max" type="xs:nonNegativeInteger" default="0"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="max_rps"          type="xs:nonNegativeInteger" minOccurs="0" default="0"/>
      <xs:element name="host"             type="xs:anyURI"             minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="mode" default="api">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="api"/>
          <xs:enumeration value="browser"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="PlanKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="suite"/>
      <xs:enumeration value="scenario_debug"/>
      <xs:enumeration value="step_debug"/>
      <xs:enumeration value="load"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DebugPrepareType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/>
      <xs:enumeration value="case"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DebugStepModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="all"/>
      <xs:enumeration value="from"/>
      <xs:enumeration value="only"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
