{
  "driver": "web",
  "browser": "chromium",
  "headless": false,
  "timeout": 60,
  "log_level": "INFO",
  "log_dir": "logs",
  "report_format": "html",
  "auto_screenshot_on_failure": true,
  "auto_screenshot_on_step": true,
  "screenshot_dir": "screenshots",
  "recording": {
    "enabled": false,
    "mode": "auto",
    "scope": "target",
    "output_dir": "recordings",
    "fps": 10,
    "max_duration": 600,
    "retain_on_pass": true,
    "retain_on_fail": true,
    "prefer_playwright_native_in_headless": true,
    "capture_input": false,
    "event_timeline": false,
    "monitor_id": null,
    "video_size": "screen"
  },
  "session_mode": null,
  "evidence_mode": null
}